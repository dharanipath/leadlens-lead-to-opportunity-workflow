[{"rule_id":"SR-V1-001","version":1,"dimension":"fit","feature":"industry","rule_type":"lookup","params":"{\"map\":{\"Education\":3,\"Energy\":6,\"FinTech\":12,\"Healthcare\":10,\"Logistics\":7,\"Manufacturing\":8,\"Media\":5,\"Retail\":5,\"Software\":12,\"Telecom\":9}}","max_points":12,"description":"Industry match against ideal-customer-profile (ICP) tiers","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-002","version":1,"dimension":"fit","feature":"employee_count","rule_type":"band","params":"{\"bands\":[[1000,14],[200,10],[50,6],[10,3],[0,1]]}","max_points":14,"description":"Company size band (employees) - larger accounts have bigger deal potential","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-003","version":1,"dimension":"fit","feature":"seniority","rule_type":"lookup","params":"{\"map\":{\"C-level\":10,\"Director\":6,\"IC\":1,\"Manager\":3,\"VP\":8}}","max_points":10,"description":"Buyer seniority - proxy for decision authority","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-004","version":1,"dimension":"fit","feature":"region","rule_type":"lookup","params":"{\"map\":{\"APAC\":2,\"EMEA\":3,\"LATAM\":1,\"NA-East\":4,\"NA-West\":4,\"Other\":0}}","max_points":4,"description":"Strategic region priority","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-005","version":1,"dimension":"fit","feature":"free_email","rule_type":"flag","params":"{\"points\":-10}","max_points":0,"description":"Penalty: personal/free e-mail domain instead of a corporate domain","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-006","version":1,"dimension":"intent","feature":"act:demo_request","rule_type":"flag_count","params":"{\"points\":15}","max_points":15,"description":"Explicit demo request in the last 30 days","effective_from":"2026-01-01","effective_to":"","is_active":1},{"rule_id":"SR-V1-007","version":1,"dimension":"int